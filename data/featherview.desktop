[Desktop Entry]
Name=FeatherView
GenericName=Image Viewer
Comment=Ultra-lightweight, blazing-fast image viewer
Exec=featherview %U
Icon=featherview
Terminal=false
Type=Application
StartupNotify=true
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/png;image/tiff;image/x-bmp;image/x-png;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-tga;image/x-xbitmap;image/webp;image/svg+xml;image/avif;
Keywords=Picture;Image;Graphic;Photo;Viewer;FeatherView;
Actions=Slideshow;

[Desktop Action Slideshow]
Name=Start Slideshow
Exec=featherview --slideshow %U
